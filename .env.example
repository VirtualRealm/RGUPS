DATABASE_URL=postgresql://portal:local_dev_change_me@localhost:5432/portal
POSTGRES_USER=portal
POSTGRES_PASSWORD=local_dev_change_me
POSTGRES_DB=portal
APP_URL=http://127.0.0.1:3000
# local = write activation/reset emails into ignored .local/mail (loopback only).
# smtp = deliver via university SMTP; never use local mail on a public server.
MAIL_MODE=local
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Set 1 ONLY behind a trusted proxy that replaces X-Real-IP and blocks direct access.
TRUST_PROXY=0
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
