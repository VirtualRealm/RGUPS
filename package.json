{
  "name": "rgups-voronezh-portal",
  "version": "1.0.0-rc.1",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "dev:local": "node scripts/local-dev.mjs",
    "build": "next build",
    "build:public": "node scripts/build-public.mjs",
    "build:offline": "node scripts/build-offline.mjs && node scripts/check-offline.mjs",
    "start": "node --env-file-if-exists=.env scripts/check-runtime.mjs && next start",
    "check:production": "node --env-file-if-exists=.env scripts/check-runtime.mjs",
    "check:services": "node --env-file-if-exists=.env scripts/check-services.mjs",
    "db:prepare": "node --env-file-if-exists=.env scripts/prepare-database.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:accounts": "tsx scripts/test-accounts.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:validate": "prisma validate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "accounts:admin": "tsx scripts/grant-admin.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "dotenv": "18.0.6",
    "lucide-react": "1.53.0",
    "next": "16.4.0",
    "nodemailer": "file:vendor/nodemailer-10.1.0.tgz",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "file:vendor/server-only-0.0.1.tgz",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.4",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.1",
    "eslint-config-next": "16.4.0",
    "prettier": "3.9.9",
    "prisma": "7.10.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.7.0"
  }
}
